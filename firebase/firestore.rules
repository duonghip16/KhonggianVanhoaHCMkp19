rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function admin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function evidence(d) {
      return d.source is string && d.source.size() > 0
        && d.verifiedBy is string && d.verifiedBy.size() > 0
        && d.verifiedOn is string && d.verifiedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function valid(col, d) {
      return d.status in ['draft', 'pending', 'verified', 'published']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.text is string && d.text.size() <= 20000
        && d.name is string && d.name.size() <= 60
        && (!(d.status in ['verified', 'published']) || (evidence(d)
          && (!(col in ['deeds', 'messages']) || d.consent == true)
          && (col != 'site_stats' || (d.value is number && d.value >= 0 && d.period is string && d.period.size() > 0))
          && (col != 'media' || (d.category is string && d.category.size() > 0 && d.url is string && d.url.size() > 0 && d.date is string && d.date.size() > 0 && d.photographer is string && d.photographer.size() > 0 && d.permission is string && d.permission.size() > 0))
          && (col != 'stories' || (d.text.size() > 0 && d.date is string && d.date.size() > 0))
          && (col != 'activities' || (d.text.size() > 0 && d.date is string && d.date.size() > 0 && d.category is string && d.category.size() > 0))
          && (col != 'daily_challenges' || (d.text.size() > 0 && d.category is string && d.category.size() > 0))
          && (col != 'quiz_questions' || (d.text.size() > 0 && d.options is string && d.options.size() > 0 && d.options.size() <= 2000 && d.correct is int && d.correct >= 0 && d.correct <= 3))
          && (col != 'library' || (d.url is string && d.url.size() > 0))));
    }
    function linkedSubmission(col, id) {
      let gate = getAfter(/databases/$(db)/documents/submission_limits/public).data;
      return gate.collection == col && gate.id == id && gate.submittedAt == request.time;
    }
    match /submission_limits/public {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['collection', 'id', 'submittedAt'])
        && request.resource.data.collection in ['deeds', 'messages']
        && request.resource.data.id is string
        && request.resource.data.id.matches('^[A-Za-z0-9-]{1,80}$')
        && request.resource.data.submittedAt == request.time
        && (!exists(/databases/$(db)/documents/submission_limits/public)
          || request.time >= resource.data.submittedAt + duration.value(5, 's'))
        && !exists(/databases/$(db)/documents/$(request.resource.data.collection)/$(request.resource.data.id))
        && getAfter(/databases/$(db)/documents/$(request.resource.data.collection)/$(request.resource.data.id)).data.status == 'pending'
        && getAfter(/databases/$(db)/documents/$(request.resource.data.collection)/$(request.resource.data.id)).data.createdAt == request.time;
    }
    match /{col}/{id} {
      allow read: if col in ['stories', 'activities', 'library', 'deeds', 'messages', 'site_stats', 'media', 'quiz_questions', 'daily_challenges']
        && (admin() || resource.data.status == 'published');
      allow create: if col in ['deeds', 'messages']
        && linkedSubmission(col, id)
        && request.resource.data.keys().hasOnly(['text', 'name', 'title', 'date', 'consent', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['text', 'name', 'consent', 'status', 'createdAt'])
        && request.resource.data.consent == true
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200))
        && (!('date' in request.resource.data) || (request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.status == 'pending'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 400
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow create, update: if col in ['stories', 'activities', 'library', 'deeds', 'messages', 'site_stats', 'media', 'quiz_questions', 'daily_challenges']
        && admin() && valid(col, request.resource.data);
      allow delete: if false;
    }
  }
}
