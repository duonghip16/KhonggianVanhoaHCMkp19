# Copy to .env.local; never commit real credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_STORAGE_ENABLED=false
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Required before public deployment: your real HTTPS origin.
NEXT_PUBLIC_SITE_URL=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
# Server only, never NEXT_PUBLIC_.
IMAGEKIT_PRIVATE_KEY=
# Optional override: IP header overwritten by your trusted hosting proxy.
# On Vercel, x-vercel-forwarded-for is selected automatically.
# Elsewhere without an override, unidentified visitors share the rate limit.
CONTRIBUTION_IP_HEADER=
